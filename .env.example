# Copy this file to .env and fill in your own keys. Never commit .env.
# All providers use the OpenAI-compatible API, so only these values change.
# Providers are tried in order: LLM_*, then FALLBACK1_*, FALLBACK2_*, FALLBACK3_*.
# Models checked on 2026-10-11; free-tier model lists change, so update if a call returns 404.

# Primary: Gemini free tier (https://aistudio.google.com/apikey). Measured 2026-10-11: 20 requests/day per model.
# Gemini 3.x "thinks" before answering; "low" keeps that short.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_REASONING_EFFORT=low
LLM_API_KEY=

# Fallback 1: another Gemini model; it has its own daily quota and uses the same key
FALLBACK1_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK1_MODEL=gemini-3.6-flash
FALLBACK1_REASONING_EFFORT=low
FALLBACK1_API_KEY=

# Fallback 2: Groq free tier (https://console.groq.com/keys)
FALLBACK2_BASE_URL=https://api.groq.com/openai/v1
FALLBACK2_MODEL=openai/gpt-oss-120b
FALLBACK2_API_KEY=

# Fallback 3: OpenRouter free models (https://openrouter.ai/keys), ~50 requests/day without credits
FALLBACK3_BASE_URL=https://openrouter.ai/api/v1
FALLBACK3_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FALLBACK3_API_KEY=
